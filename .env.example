# Copiá este archivo como .env y completá los valores.
# El .env NO se versiona: tiene la contraseña de la base.

# ---------------------------------------------------------------------------
# Base de datos · Supabase
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → Session pooler
#
# ⚠️ Usá la del SESSION POOLER, no la "Direct connection".
#    La directa (db.<ref>.supabase.co) es IPv6, y la mayoría de las conexiones
#    hogareñas argentinas no tienen IPv6: falla con "network is unreachable" y
#    parece que la contraseña está mal.
#
# ⚠️ Si la contraseña tiene caracteres raros (@ : / ?) hay que escaparlos. Lo
#    más fácil es generar una sin ellos desde el panel de Supabase.

DATABASE_URL=postgresql://postgres.abcdefghijklm:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# En tu máquina dejalos como están. En un servidor de verdad: DJANGO_DEBUG=False
# y una SECRET_KEY larga y secreta.

# DJANGO_SECRET_KEY=algo-largo-y-secreto
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Mail (opcional) · recordatorios de eventos, RN-24
# ---------------------------------------------------------------------------
# Sin esto los mails se imprimen en la terminal en vez de enviarse, que es lo
# que querés mientras probás. Con Gmail va una CONTRASEÑA DE APLICACIÓN.

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=salonvictoria@gmail.com
# EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=Salon Victoria <salonvictoria@gmail.com>
# DIAS_AVISO_EVENTO=7
